<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_xl"
    android:paddingTop="@dimen/message_margin_v"
    android:paddingEnd="@dimen/message_margin_h"
    android:paddingBottom="@dimen/message_margin_v">

    <TextView
        android:id="@+id/text_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_user_bubble"
        android:paddingStart="@dimen/message_padding_h"
        android:paddingTop="@dimen/message_padding_v"
        android:paddingEnd="@dimen/message_padding_h"
        android:paddingBottom="@dimen/message_padding_v"
        android:textColor="@color/bubble_user_text"
        android:textIsSelectable="true"
        android:textSize="@dimen/message_text_size"
        android:lineSpacingExtra="2dp" />

    <TextView
        android:id="@+id/text_attachments"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
